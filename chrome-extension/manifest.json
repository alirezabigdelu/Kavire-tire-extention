{
  "manifest_version": 3,
  "name": "TireBot کویر تایر",
  "version": "1.3.0",
  "description": "ربات کمکی خرید لاستیک در سایت کویر تایر (kavirtire.ir). پرداخت نهایی با خود کاربر است.",
  "author": "Alireza Bigdeloo",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://kavirtire.ir/*", "*://*.kavirtire.ir/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "TireBot",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
